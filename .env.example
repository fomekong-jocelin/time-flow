# Database
DB_URL=jdbc:postgresql://localhost:5432/timeflow
DB_USERNAME=timeflow
DB_PASSWORD=timeflow

# Microsoft Entra ID — never commit real values
ENTRA_SSO_ENABLED=false
ENTRA_TENANT_ID=replace-me
ENTRA_CLIENT_ID=replace-me
ENTRA_CLIENT_SECRET=replace-me
BOOTSTRAP_ADMIN_EMAILS=admin@your-company.example

# Initial local administrator
# Enabled by default for local/development startup.
# The password is generated automatically and printed once in the backend console.
TIMEFLOW_AUTO_BOOTSTRAP_ADMIN=true
TIMEFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@indyli-services.com
TIMEFLOW_BOOTSTRAP_ADMIN_NAME=Administrateur TimeFlow

# Azure DevOps projects — backend environment only, never expose the PAT in the SPA
TIMEFLOW_AZURE_ORGANIZATION=
TIMEFLOW_AZURE_PAT=

# Browser / session
FRONTEND_URL=http://localhost:4200
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=8h
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=15
